<?xml version="1.0" encoding="utf-8"?>
<!--
  Two crescents: one large, one small, sharing a direction — the two of us.

  Each crescent is a single evenOdd path holding two circles, so the smaller one subtracts
  from the larger. Everything sits inside the 72dp safe zone of the 108dp adaptive viewport
  (max reach ~31dp from centre), so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillType="evenOdd"
        android:fillColor="#E8A268"
        android:pathData="M24,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0 M37,49 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0" />

    <path
        android:fillType="evenOdd"
        android:fillColor="#E0938A"
        android:pathData="M59,66 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 M66.5,62 a11.5,11.5 0 1,0 23,0 a11.5,11.5 0 1,0 -23,0" />

</vector>
