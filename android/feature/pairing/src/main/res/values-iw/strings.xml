<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pairing_choose_title">הגדרת המרחב המשותף</string>
    <string name="pairing_choose_body">אחד מכם יוצר את המרחב, והשני מצטרף עם קוד. רק שניכם יכולים לקרוא את מה שבפנים.</string>
    <string name="pairing_create">יצירת מרחב חדש</string>
    <string name="pairing_join">הצטרפות עם קוד</string>

    <string name="pairing_phrase_title">כתבו את 24 המילים האלה</string>
    <string name="pairing_phrase_body">המילים האלה הן המפתח לנתונים שלכם. אם שני הטלפונים יאבדו והמילים לא יהיו אצלכם, אי אפשר יהיה לשחזר כלום — לא על ידינו ולא על ידי אף אחד. כתבו אותן על נייר ושמרו במקום בטוח.</string>
    <string name="pairing_phrase_confirm">כתבתי אותן</string>
    <string name="pairing_phrase_continue">המשך</string>
    <string name="pairing_phrase_copy">העתקת המשפט</string>

    <string name="pairing_code_title">הזינו את הקוד</string>
    <string name="pairing_code_body">בקשו מבן/בת הזוג לפתוח את האפליקציה ולהקריא את הקוד שמופיע.</string>
    <string name="pairing_code_label">קוד הזמנה</string>
    <string name="pairing_code_submit">הצטרפות</string>
    <string name="pairing_code_scan">סריקת קוד QR במקום זאת</string>

    <string name="pairing_waiting_title">כמעט סיימנו</string>
    <string name="pairing_waiting_body">הצטרפתם למרחב. בן/בת הזוג צריכים לאשר את הטלפון הזה לפני שיוכל לקרוא משהו — בקשו מהם ללחוץ על אישור ואז בדקו שוב.</string>
    <string name="pairing_check_again">בדיקה חוזרת</string>
    <string name="pairing_recover_with_phrase">שחזור עם משפט במקום זאת</string>

    <string name="pairing_recovery_entry_title">הזינו את משפט השחזור שלכם</string>
    <string name="pairing_recovery_entry_body">הקלידו את 24 המילים שכתבתם כשהמרחב הזה נוצר, מופרדות ברווחים, לפי הסדר.</string>
    <string name="pairing_recovery_entry_label">משפט שחזור</string>
    <string name="pairing_recovery_entry_submit">שחזור</string>
    <string name="pairing_recovery_entry_cancel">ביטול</string>

    <string name="pairing_ready_title">המרחב שלכם מוכן</string>
    <string name="pairing_invite_generate">הזמנת בן/בת הזוג</string>
    <string name="pairing_invite_body">תנו לבן/בת הזוג לסרוק את הקוד הזה, או הקריאו אותו להם. הוא תקף לשימוש אחד ופג תוך 24 שעות.</string>
    <string name="pairing_invite_qr_description">קוד QR להזמנה</string>
    <string name="pairing_invite_copy">העתקת הקוד</string>
    <string name="pairing_pending_title">ממתין לאישור</string>
    <string name="pairing_pending_body">הטלפון הזה הצטרף למרחב שלכם. אשרו רק אם אתם מזהים אותו — אישור מוסר לו את המפתח להכול.</string>
    <string name="pairing_approve">אישור</string>
    <string name="pairing_continue">המשך לאפליקציה</string>
    <string name="pairing_devices_title">מכשירים מקושרים</string>
    <string name="pairing_revoke">שלילת הרשאה</string>

    <string name="pairing_error_offline">אין חיבור. בדקו את האינטרנט ונסו שוב.</string>
    <string name="pairing_error_timeout">השרת לא הגיב בזמן. נסו שוב.</string>
    <string name="pairing_error_invalid_code">הקוד אינו תקף. ייתכן שפג תוקפו או שכבר נעשה בו שימוש.</string>
    <string name="pairing_error_workspace_full">במרחב הזה כבר נמצאים שני אנשים.</string>
    <string name="pairing_error_key_mismatch">הטלפון הזה לא הצליח לפתוח את המפתח שקיבל.</string>
    <string name="pairing_error_invalid_phrase">המשפט אינו תקף. בדקו את המילים ונסו שוב.</string>
    <string name="pairing_error_generic">משהו השתבש. נסו שוב.</string>

    <string name="pairing_sign_out">התנתקות</string>
    <string name="pairing_sign_out_title">להתנתק?</string>
    <string name="pairing_sign_out_body">יהיה עליכם להתחבר מחדש כדי לנסות חשבון אחר.</string>
</resources>
