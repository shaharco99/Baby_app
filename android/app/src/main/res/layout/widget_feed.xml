<?xml version="1.0" encoding="utf-8"?>
<!-- The feed widget. Drawn by RemoteViews, so plain views only; see FeedWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_feed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_feed_next"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <Chronometer
        android:id="@+id/widget_feed_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:textColor="@color/widget_foreground"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/widget_feed_last"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
